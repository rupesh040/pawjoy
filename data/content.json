      "FAQ": {
        "variants": {
          "PawJoyFAQ1": {
            "id": "faqs",
            "tagline": "Frequently Asked Questions",
            "taglineIcon": "paw",
            "headingPart1": "Got Questions? ",
            "headingHighlight": "We've Got Answers",
            "description": "Find answers to commonly asked questions about our services, booking process, safety protocols, and pet wellness standards.",
            "image": {
              "src": "/faq.webp",
              "alt": "Happy golden retriever and tabby cat resting peacefully together",
              "badgeText": "Compassionate & Reliable Care",
              "badgeIcon": "?"
            },
            "items": [
              {
                "id": "1",
                "question": "What pet care services does PawJoy offer?",
                "answer": "We offer a complete suite of pet care services including professional grooming and spa treatments, routine veterinary examinations, daily dog walking, positive reinforcement training, and luxury overnight boarding and daycare."
              },
              {
                "id": "2",
                "question": "How do I schedule an appointment for my pet?",
                "answer": "You can easily book online through our contact page or by calling our customer care team directly. We recommend booking in advance, especially during holiday periods and peak weekends."
              },
              {
                "id": "3",
                "question": "What vaccinations are required before visiting?",
                "answer": "To protect all pets in our care, dogs must be up to date on Rabies, DHPP, and Bordetella vaccinations. Cats must be current on Rabies and FVRCP. We request vaccination records prior to your first appointment."
              },
              {
                "id": "4",
                "question": "Can I tour your facility before booking?",
                "answer": "Yes! We welcome pet parents to visit and tour our state-of-the-art facility during regular business hours to see our play areas, grooming stations, and sleeping suites."
              },
              {
                "id": "5",
                "question": "How do your staff handle pets with anxiety or special needs?",
                "answer": "Our certified veterinary assistants and caregivers are trained in low-stress handling methods. We provide quiet, soothing spaces and customized schedules to ensure nervous or senior pets feel completely safe and relaxed."
              }
            ],
